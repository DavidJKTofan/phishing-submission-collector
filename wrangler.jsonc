{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "phish-submission-collector",
	"main": "src/index.ts",
	// Bump periodically (Workers best practices). Node.js compatibility
	// (`nodejs_compat` + `nodejs_compat_v2`) is enabled by default for dates
	// >= 2026-08-04, so the flag is no longer declared; do not lower this date
	// without adding "nodejs_compat" back to compatibility_flags.
	"compatibility_date": "2026-11-13",
	// Workers best practices: upload source maps so stack traces in Workers Logs
	// point at the TypeScript source, not the bundle.
	"upload_source_maps": true,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"workers_dev": false,
	"preview_urls": false,
	// Production is served from this Custom Domain (the Worker is the origin).
	// Declared here for parity with staging; wrangler adopts the already-attached
	// domain, so a deploy is a no-op for DNS.
	"routes": [
		{
			"pattern": "report.automatic-demo.com",
			"custom_domain": true
		}
	],
	"vars": {
		"ALLOWED_ORIGINS": "https://report.automatic-demo.com",
		"TURNSTILE_EXPECTED_HOSTNAMES": "report.automatic-demo.com",
		"CLOUDFLARE_GATEWAY_HOSTNAME_LIST_NAME": "0_PHISHING_Hostnames",
		"REPORTER_NAME": "PRIVATE"
	},
	"secrets": {
		"required": [
			"TURNSTILE_SECRET_KEY",
			"URLSCAN_API_KEY",
			"VIRUSTOTAL_API_KEY",
			"IPQS_API_KEY",
			"REPORTER_EMAIL",
			"CLOUDFLARE_ACCOUNT_ID",
			"CLOUDFLARE_API_TOKEN",
			"DISCORD_APPLICATION_PUBLIC_KEY",
			"DISCORD_BOT_TOKEN",
			"DISCORD_APPROVAL_CHANNEL_ID"
		]
	},
	"workflows": [
		{
			"name": "phishing-hostname-approval",
			"binding": "PHISHING_HOSTNAME_WORKFLOW",
			"class_name": "PhishingHostnameWorkflow"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "reports_db",
			"database_id": "8ec44b1e-510c-4f6e-a239-0ba3a7361925",
			"migrations_dir": "migrations"
		}
	],
	// Low-volume security tool: capture every invocation so any individual
	// submission or approval can be debugged from Workers Logs / Traces. Lower
	// the sampling rates if volume or billing ever makes that necessary.
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	},
	"env": {
		"staging": {
			"name": "phish-submission-collector-staging",
			"workers_dev": false,
			"preview_urls": false,
			"routes": [
				{
					"pattern": "report-staging.automatic-demo.com",
					"custom_domain": true
				}
			],
			"vars": {
				"ALLOWED_ORIGINS": "https://report-staging.automatic-demo.com",
				"TURNSTILE_EXPECTED_HOSTNAMES": "report-staging.automatic-demo.com",
				// Staging runs Turnstile's always-pass testing keys (sitekey in public/index.html,
				// secret via `wrangler secret put TURNSTILE_SECRET_KEY --env staging`) so agents can
				// submit through the form. The Worker refuses a testing secret without this opt-in.
				// NEVER add this var to production.
				"TURNSTILE_ALLOW_TESTING_KEYS": "true",
				"CLOUDFLARE_GATEWAY_HOSTNAME_LIST_NAME": "0_PHISHING_Hostnames_STAGING",
				"REPORTER_NAME": "PRIVATE"
			},
			"secrets": {
				"required": [
					"TURNSTILE_SECRET_KEY",
					"URLSCAN_API_KEY",
					"VIRUSTOTAL_API_KEY",
					"IPQS_API_KEY",
					"REPORTER_EMAIL",
					"CLOUDFLARE_ACCOUNT_ID",
					"CLOUDFLARE_API_TOKEN",
					"DISCORD_APPLICATION_PUBLIC_KEY",
					"DISCORD_BOT_TOKEN",
					"DISCORD_APPROVAL_CHANNEL_ID"
				]
			},
			"workflows": [
				{
					"name": "phishing-hostname-approval-staging",
					"binding": "PHISHING_HOSTNAME_WORKFLOW",
					"class_name": "PhishingHostnameWorkflow"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "reports_db_staging",
					"database_id": "f9cd2bb7-4e23-4865-8202-96c4bcb8d965",
					"migrations_dir": "migrations"
				}
			]
		}
	}
}
