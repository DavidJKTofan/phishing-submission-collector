{
  "name": "phish-submission-collector",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "cf-typegen": "wrangler types --config wrangler.jsonc",
    "check": "npm run typecheck && tsc -p tests/tsconfig.json --noEmit && node --check public/assets/scripts.js && node --check public/assets/report.js && node --check public/assets/theme.js",
    "check:startup": "wrangler check startup --config wrangler.jsonc --env \"\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "wrangler d1 migrations apply reports_db --remote --config wrangler.jsonc --env \"\"",
    "migrate:staging": "wrangler d1 migrations apply reports_db_staging --remote --config wrangler.jsonc --env staging",
    "deploy": "wrangler deploy --config wrangler.jsonc --env \"\"",
    "deploy:staging": "wrangler deploy --config wrangler.jsonc --env staging",
    "deploy:dry-run": "wrangler deploy --dry-run --config wrangler.jsonc --env \"\"",
    "deploy:staging:dry-run": "wrangler deploy --dry-run --config wrangler.jsonc --env staging",
    "dev": "wrangler dev --config wrangler.jsonc --env \"\"",
    "dev:staging": "wrangler dev --config wrangler.jsonc --env staging",
    "start": "wrangler dev --config wrangler.jsonc --env \"\"",
    "typecheck": "npm run cf-typegen && tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "~4.1.12",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261113.1": true
  }
}
