# Cloudflare Access service token for the staging app (report-staging.automatic-demo.com).
# Copy to `.env.staging-access` (gitignored, chmod 600). Consumed by
# scripts/staging-check.sh and by agents running curl checks against staging.
#
# Create at Zero Trust > Access controls > Service credentials > Service Tokens,
# then bind it to the staging Access application with a policy:
#   Action: Service Auth · Include: Service Token · <this token>
# Rotate the secret there if it is ever exposed (the Client ID stays the same).
CF_ACCESS_CLIENT_ID="<client-id>.access"
CF_ACCESS_CLIENT_SECRET="<client-secret>"
